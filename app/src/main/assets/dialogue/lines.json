{
  "_note": "Rin's offline voice pack script (task 4.1, D20; one-way only since D21; nothing carried between days since D22: no streak, no Bond). Rules: docs/character/script-bible.md. Check and review table: node tools/voice/script-check.mjs. v1 approved by the user 2026-09-30. Ids never change or get reused once 4.3 records them. 'text' is shown on screen ('~' is screen-only and never sent to TTS); 'say' overrides what TTS reads; 'tag' is an eleven_v3 audio tag. Repeat-after-Rin sentences R01-R30 live in assets/repeat/sentences.json and are recorded with this pack.",
  "version": 1,
  "budget": { "credits": 30000, "scriptMax": 15000 },
  "tags": ["[sleepy]", "[yawns]", "[softly]", "[gently]", "[whispers]", "[warmly]", "[cheerfully]", "[excited]", "[playfully]", "[giggles]", "[proudly]", "[pouting]", "[sighs]", "[concerned]", "[curious]", "[thinking]"],
  "pools": {
    "ring.sleepy":      { "use": "daily",   "when": "Ring start, mood sleepy (default 22:00-06:00). One line; the alarm tone ducks while she speaks." },
    "ring.cheerful":    { "use": "daily",   "when": "Ring start, mood cheerful (other hours)." },
    "ring.dayoff":      { "use": "daily",   "when": "Ring start on Saturday or Sunday (replaces sleepy/cheerful)." },
    "ring.late":        { "use": "event",   "when": "Ring start when the ring is late (phone was asleep)." },
    "snooze.first":     { "use": "event",   "when": "The user taps Snooze for the first time this morning." },
    "snooze.again":     { "use": "event",   "when": "A snooze that is neither the first nor the last allowed." },
    "snooze.last":      { "use": "event",   "when": "The last allowed snooze (cap from the alarm editor). With a cap of 1, first wins." },
    "back.first":       { "use": "event",   "when": "Re-ring after the first snooze." },
    "back.again":       { "use": "event",   "when": "Re-ring after a middle snooze." },
    "back.last":        { "use": "event",   "when": "Re-ring after the last allowed snooze: no Snooze button now." },
    "emergency":        { "use": "event",   "when": "Emergency hold-to-stop. Short, no teasing." },
    "game.intro":       { "use": "daily",   "when": "Game start, any game. Mixed with the game's own pool." },
    "game.intro.pads":  { "use": "daily", "mix": "game.intro",   "when": "Game start, colour pads." },
    "game.intro.cups":  { "use": "daily", "mix": "game.intro",   "when": "Game start, cup shuffle." },
    "game.intro.speech":{ "use": "daily", "mix": "game.intro",   "when": "Game start, Repeat after Rin." },
    "pads.slow":        { "use": "session", "when": "Pads: too slow (3 s gap). 01-03 are set A from 3.3." },
    "pads.wrong":       { "use": "session", "when": "Pads: wrong colour. 01-03 are set A from 3.3." },
    "cups.wrong":       { "use": "session", "when": "Cups: wrong cup. 01-03 are set A from 3.4." },
    "speech.missed":    { "use": "session", "when": "Repeat after Rin: heard, but not enough words." },
    "speech.nothing":   { "use": "session", "when": "Repeat after Rin: heard nothing." },
    "speech.totap":     { "use": "session", "when": "Repeat after Rin: switching to tapping the words. The mic is used only in this game (D21)." },
    "won.clean":        { "use": "daily",   "when": "Game won with no mistakes." },
    "won.hard":         { "use": "daily",   "when": "Game won after mistakes or slow rounds." },
    "after.remark":     { "use": "daily",   "when": "Right after the won line: one short one-way remark that ends with a goodbye, drawn together with the meal pool for the ring time. Never says what the weather is: Rin can't know it (D21 review)." },
    "after.meal.breakfast": { "use": "daily", "mix": "after.remark", "when": "Remark about the meal ahead, ring time 04:00-10:59. Why the meal matters, no dish names, no health claims." },
    "after.meal.lunch": { "use": "daily", "mix": "after.remark", "when": "Meal remark, ring time 11:00-15:59." },
    "after.meal.dinner":{ "use": "daily", "mix": "after.remark", "when": "Meal remark, ring time 16:00-21:59." },
    "after.meal.late":  { "use": "daily", "mix": "after.remark", "when": "Meal remark, ring time 22:00-03:59." },
    "app.morning":      { "use": "event",   "when": "App opened (not ringing), 05:00-11:59. Plays with the greeting wave (2.4)." },
    "app.afternoon":    { "use": "event",   "when": "App opened, 12:00-17:59." },
    "app.evening":      { "use": "event",   "when": "App opened, 18:00-21:59." },
    "app.night":        { "use": "event",   "when": "App opened, 22:00-04:59. Gentle, no pressure." },
    "app.alarmset":     { "use": "event",   "when": "An alarm was saved (any time of day)." },
    "tap.head":         { "use": "session", "when": "Head tap (2.2). She never asks for a reply." },
    "p5.rest":          { "use": "event",   "when": "Phase 5: rest day, one tap on the home screen (no game)." },
    "p5.sick":          { "use": "event",   "when": "Phase 5: sick day, one tap on the home screen (no game, no pouting)." }
  },
  "lines": [
    {"id": "ring.sleepy.01", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": "yawn", "tag": "[sleepy]", "text": "Mmh… morning already? Let's wake up together."},
    {"id": "ring.sleepy.02", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": "stretch", "tag": "[softly]", "text": "Morning, sleepyhead~ I'm still waking up too."},
    {"id": "ring.sleepy.03", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": null, "tag": "[softly]", "text": "It's early, I know. Just open your eyes."},
    {"id": "ring.sleepy.04", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": null, "tag": "[whispers]", "text": "Shh. A quiet morning. Let's get up slowly."},
    {"id": "ring.sleepy.05", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": "stretch", "tag": "[sleepy]", "text": "Good morning. Slowly is fine, just stay awake."},
    {"id": "ring.sleepy.06", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": "yawn", "tag": "[yawns]", "text": "Oops. Excuse me. Good morning!"},
    {"id": "ring.sleepy.07", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": "wave", "tag": "[softly]", "text": "Early start today. I'll keep you company."},
    {"id": "ring.sleepy.08", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": null, "tag": "[playfully]", "text": "Wake-up time. Blanket off, one corner at a time."},
    {"id": "ring.sleepy.09", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": null, "tag": "[softly]", "text": "Hey. The world is quiet right now. Let's get up."},
    {"id": "ring.sleepy.10", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": "nod", "tag": "[gently]", "text": "Eyes open for me? Just a little."},

    {"id": "ring.cheerful.01", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "wave", "tag": "[cheerfully]", "text": "Good morning! Rise and shine~"},
    {"id": "ring.cheerful.02", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "wave", "tag": null, "text": "Morning! A brand-new day is waiting."},
    {"id": "ring.cheerful.03", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "wave", "tag": null, "text": "Hey, it's me. Time to get up!"},
    {"id": "ring.cheerful.04", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "nod", "tag": "[warmly]", "text": "Good morning! Let's start this day together."},
    {"id": "ring.cheerful.05", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "joy", "tag": "[playfully]", "text": "Wakey, wakey! I'm right here."},
    {"id": "ring.cheerful.06", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "stretch", "tag": null, "text": "Morning! Big stretch first, okay?"},
    {"id": "ring.cheerful.07", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": null, "tag": "[playfully]", "text": "Hello, morning person! Well, almost."},
    {"id": "ring.cheerful.08", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": null, "tag": "[playfully]", "text": "Good morning! Breakfast won't make itself."},
    {"id": "ring.cheerful.09", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "nod", "tag": null, "text": "It's time! Come on, up you get."},
    {"id": "ring.cheerful.10", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "joy", "tag": "[excited]", "text": "Morning! Ready for a little game?"},

    {"id": "ring.dayoff.01", "pool": "ring.dayoff", "emotion": "cheerful", "gesture": null, "tag": "[playfully]", "text": "A day off, and still an alarm? Good morning, then!"},
    {"id": "ring.dayoff.02", "pool": "ring.dayoff", "emotion": "cheerful", "gesture": "wave", "tag": "[cheerfully]", "text": "Weekend morning! Let's not waste it."},
