{
  "_note": "Rin's offline voice pack script (task 4.1, D20; one-way only since D21). Rules: docs/character/script-bible.md. Check and review table: node tools/voice/script-check.mjs. Ids never change or get reused once 4.3 records them. 'text' is shown on screen ('~' is screen-only and never sent to TTS); 'say' overrides what TTS reads; 'tag' is an eleven_v3 audio tag. Repeat-after-Rin sentences R01-R30 live in assets/repeat/sentences.json and are recorded with this pack.",
  "version": 1,
  "budget": { "credits": 30000, "scriptMax": 15000 },
  "tags": ["[sleepy]", "[yawns]", "[softly]", "[gently]", "[whispers]", "[warmly]", "[cheerfully]", "[excited]", "[playfully]", "[giggles]", "[proudly]", "[pouting]", "[sighs]", "[concerned]", "[curious]", "[thinking]"],
  "pools": {
    "ring.sleepy":      { "use": "daily",   "when": "Ring start, mood sleepy (default 22:00-06:00). One line; the alarm tone ducks while she speaks." },
    "ring.cheerful":    { "use": "daily",   "when": "Ring start, mood cheerful (other hours)." },
    "ring.dayoff":      { "use": "daily",   "when": "Ring start on Saturday or Sunday (replaces sleepy/cheerful)." },
    "ring.late":        { "use": "event",   "when": "Ring start when the ring is late (phone was asleep)." },
    "snooze.first":     { "use": "event",   "when": "The user taps Snooze for the first time this morning." },
    "snooze.again":     { "use": "event",   "when": "A snooze that is neither the first nor the last allowed." },
    "snooze.last":      { "use": "event",   "when": "The last allowed snooze (cap from the alarm editor). With a cap of 1, first wins." },
    "back.first":       { "use": "event",   "when": "Re-ring after the first snooze." },
    "back.again":       { "use": "event",   "when": "Re-ring after a middle snooze." },
    "back.last":        { "use": "event",   "when": "Re-ring after the last allowed snooze: no Snooze button now." },
    "emergency":        { "use": "event",   "when": "Emergency hold-to-stop. Short, no teasing." },
    "game.intro":       { "use": "daily",   "when": "Game start, any game. Mixed with the game's own pool." },
    "game.intro.pads":  { "use": "daily", "mix": "game.intro",   "when": "Game start, colour pads." },
    "game.intro.cups":  { "use": "daily", "mix": "game.intro",   "when": "Game start, cup shuffle." },
    "game.intro.speech":{ "use": "daily", "mix": "game.intro",   "when": "Game start, Repeat after Rin." },
    "game.last":        { "use": "session", "when": "Start of the final round." },
    "pads.watch":       { "use": "session", "when": "Pads: before her hand shows the sequence." },
    "pads.good":        { "use": "session", "when": "Pads: a round copied right." },
    "pads.slow":        { "use": "session", "when": "Pads: too slow (3 s gap). 01-03 are set A from 3.3." },
    "pads.wrong":       { "use": "session", "when": "Pads: wrong colour. 01-03 are set A from 3.3." },
    "cups.watch":       { "use": "session", "when": "Cups: before the shuffle." },
    "cups.right":       { "use": "session", "when": "Cups: right cup." },
    "cups.wrong":       { "use": "session", "when": "Cups: wrong cup. 01-03 are set A from 3.4." },
    "speech.good":      { "use": "session", "when": "Repeat after Rin: sentence accepted." },
    "speech.missed":    { "use": "session", "when": "Repeat after Rin: heard, but not enough words." },
    "speech.nothing":   { "use": "session", "when": "Repeat after Rin: heard nothing." },
    "speech.totap":     { "use": "session", "when": "Repeat after Rin: switching to tapping the words. The mic is used only in this game (D21)." },
    "won.clean":        { "use": "daily",   "when": "Game won with no mistakes." },
    "won.hard":         { "use": "daily",   "when": "Game won after mistakes or slow rounds." },
    "after.remark":     { "use": "daily",   "when": "Right after the won line: one short one-way remark (sky, weather, Thai breakfast, the day) that ends with a goodbye. No buttons, no mic (D21)." },
    "app.morning":      { "use": "event",   "when": "App opened (not ringing), 05:00-11:59. Plays with the greeting wave (2.4)." },
    "app.afternoon":    { "use": "event",   "when": "App opened, 12:00-17:59." },
    "app.evening":      { "use": "event",   "when": "App opened, 18:00-21:59." },
    "app.night":        { "use": "event",   "when": "App opened, 22:00-04:59. Gentle, no pressure." },
    "app.alarmset":     { "use": "event",   "when": "An alarm was saved (any time of day)." },
    "tap.head":         { "use": "session", "when": "Head tap (2.2). No Bond change. She never asks for a reply." },
    "p5.streak":        { "use": "event",   "when": "Phase 5: streak milestone (see 'streak')." },
    "p5.keep":          { "use": "daily",   "when": "Phase 5: streak goes on, no milestone today." },
    "p5.broken":        { "use": "event",   "when": "Phase 5: first ring after a streak broke. Never shaming." },
    "p5.welcome":       { "use": "event",   "when": "Phase 5: first ring after 3+ days away. No guilt." },
    "p5.bond":          { "use": "event",   "when": "Phase 5: Bond level went up. Friendship, never romance." },
    "p5.rest":          { "use": "event",   "when": "Phase 5: rest day set in settings (no mission)." },
    "p5.sick":          { "use": "event",   "when": "Phase 5: sick day set in settings (no mission, no pouting, no Bond loss)." },
    "p5.missed":        { "use": "event",   "when": "Phase 5: first ring after a missed alarm. No guilt." }
  },
  "lines": [
    {"id": "ring.sleepy.01", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": "yawn", "tag": "[sleepy]", "text": "Mmh… morning already? Let's wake up together."},
    {"id": "ring.sleepy.02", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": "stretch", "tag": "[softly]", "text": "Morning, sleepyhead~ I'm still waking up too."},
    {"id": "ring.sleepy.03", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": null, "tag": "[softly]", "text": "It's early, I know. Just open your eyes."},
    {"id": "ring.sleepy.04", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": null, "tag": "[whispers]", "text": "Shh. The sun isn't up yet, but we are."},
    {"id": "ring.sleepy.05", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": "stretch", "tag": "[sleepy]", "text": "Good morning. Slowly is fine, just stay awake."},
    {"id": "ring.sleepy.06", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": "yawn", "tag": "[yawns]", "text": "Oops. Excuse me. Good morning!"},
    {"id": "ring.sleepy.07", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": "wave", "tag": "[softly]", "text": "Early start today. I'll keep you company."},
    {"id": "ring.sleepy.08", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": null, "tag": "[playfully]", "text": "Wake-up time. Blanket off, one corner at a time."},
    {"id": "ring.sleepy.09", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": null, "tag": "[softly]", "text": "Hey. The world is quiet right now. Let's get up."},
    {"id": "ring.sleepy.10", "pool": "ring.sleepy", "emotion": "sleepy", "gesture": "nod", "tag": "[gently]", "text": "Eyes open for me? Just a little."},

    {"id": "ring.cheerful.01", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "wave", "tag": "[cheerfully]", "text": "Good morning! Rise and shine~"},
    {"id": "ring.cheerful.02", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "wave", "tag": null, "text": "Morning! A brand-new day is waiting."},
    {"id": "ring.cheerful.03", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "wave", "tag": null, "text": "Hey, it's me. Time to get up!"},
    {"id": "ring.cheerful.04", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "nod", "tag": "[warmly]", "text": "Good morning! Let's start this day together."},
    {"id": "ring.cheerful.05", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "joy", "tag": "[playfully]", "text": "Wakey, wakey! I'm right here."},
    {"id": "ring.cheerful.06", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "stretch", "tag": null, "text": "Morning! Big stretch first, okay?"},
    {"id": "ring.cheerful.07", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": null, "tag": "[playfully]", "text": "Hello, morning person! Well, almost."},
    {"id": "ring.cheerful.08", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": null, "tag": "[playfully]", "text": "Good morning! Breakfast won't make itself."},
    {"id": "ring.cheerful.09", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "nod", "tag": null, "text": "It's time! Come on, up you get."},
    {"id": "ring.cheerful.10", "pool": "ring.cheerful", "emotion": "cheerful", "gesture": "joy", "tag": "[excited]", "text": "Morning! Ready for a little game?"},

    {"id": "ring.dayoff.01", "pool": "ring.dayoff", "emotion": "cheerful", "gesture": null, "tag": "[playfully]", "text": "A day off, and still an alarm? Good morning, then!"},
    {"id": "ring.dayoff.02", "pool": "ring.dayoff", "emotion": "cheerful", "gesture": "wave", "tag": "[cheerfully]", "text": "Weekend morning! Let's not waste it."},
    {"id": "ring.dayoff.03", "pool": "ring.dayoff", "emotion": "relieved", "gesture": "stretch", "tag": "[softly]", "text": "Slow morning today. Still, let's get up."},
    {"id": "ring.dayoff.04", "pool": "ring.dayoff", "emotion": "cheerful", "gesture": "joy", "tag": null, "text": "Morning! A free day ahead. What a nice start."},
    {"id": "ring.dayoff.05", "pool": "ring.dayoff", "emotion": "relieved", "gesture": "nod", "tag": "[warmly]", "text": "Good morning. Today can be easy."},
    {"id": "ring.dayoff.06", "pool": "ring.dayoff", "emotion": "cheerful", "gesture": "wave", "tag": "[playfully]", "text": "Hey, weekend you. Up we get~"},
    {"id": "ring.dayoff.07", "pool": "ring.dayoff", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Morning! The sun's up, and the day is yours."},

    {"id": "ring.late.01", "pool": "ring.late", "emotion": "worried", "gesture": null, "tag": "[concerned]", "text": "Sorry, I'm late! Your phone was asleep."},
    {"id": "ring.late.02", "pool": "ring.late", "emotion": "worried", "gesture": null, "tag": "[concerned]", "text": "Oh no, I rang late. Let's get up, gently."},
    {"id": "ring.late.03", "pool": "ring.late", "emotion": "worried", "gesture": null, "tag": null, "text": "I'm a bit late today. Sorry! Up we go."},

    {"id": "snooze.first.01", "pool": "snooze.first", "emotion": "cheerful", "gesture": "nod", "tag": "[playfully]", "text": "A few more minutes… just this once!"},
    {"id": "snooze.first.02", "pool": "snooze.first", "emotion": "cheerful", "gesture": "nod", "tag": null, "text": "Okay, a short nap. I'll call you again."},
    {"id": "snooze.first.03", "pool": "snooze.first", "emotion": "cheerful", "gesture": null, "tag": "[sighs]", "text": "Fine, fine. Just a little longer."},
    {"id": "snooze.first.04", "pool": "snooze.first", "emotion": "cheerful", "gesture": "wave", "tag": null, "text": "Snooze accepted. See you very soon~"},
    {"id": "snooze.again.01", "pool": "snooze.again", "emotion": "pouty", "gesture": "pout", "tag": "[pouting]", "text": "Again? The blanket is winning…"},
    {"id": "snooze.again.02", "pool": "snooze.again", "emotion": "pouty", "gesture": "huff", "tag": null, "text": "Hmph. Okay, but that's two times now."},
    {"id": "snooze.again.03", "pool": "snooze.again", "emotion": "pouty", "gesture": "pout", "tag": "[pouting]", "text": "Snooze again? I'm pouting a little."},
    {"id": "snooze.again.04", "pool": "snooze.again", "emotion": "pouty", "gesture": "huff", "tag": "[playfully]", "text": "Again? You and that pillow…"},
    {"id": "snooze.last.01", "pool": "snooze.last", "emotion": "sulky", "gesture": "huff", "tag": null, "text": "Okay. Last one. I'm counting, you know."},
    {"id": "snooze.last.02", "pool": "snooze.last", "emotion": "sulky", "gesture": "shake", "tag": null, "text": "That's the last snooze. Next time, we play."},
    {"id": "snooze.last.03", "pool": "snooze.last", "emotion": "sulky", "gesture": "huff", "tag": "[sighs]", "text": "Fine. Last one. No more after this."},
    {"id": "snooze.last.04", "pool": "snooze.last", "emotion": "sulky", "gesture": null, "tag": null, "text": "Last time, okay? I mean it."},

    {"id": "back.first.01", "pool": "back.first", "emotion": "cheerful", "gesture": "wave", "tag": "[cheerfully]", "text": "Nap's over! Good morning, again~"},
    {"id": "back.first.02", "pool": "back.first", "emotion": "cheerful", "gesture": null, "tag": null, "text": "I'm back. Ready now?"},
    {"id": "back.first.03", "pool": "back.first", "emotion": "cheerful", "gesture": "joy", "tag": "[playfully]", "text": "Round two of good morning!"},
    {"id": "back.again.01", "pool": "back.again", "emotion": "pouty", "gesture": null, "tag": "[pouting]", "text": "Me again. Still sleepy?"},
    {"id": "back.again.02", "pool": "back.again", "emotion": "pouty", "gesture": "shake", "tag": "[playfully]", "text": "Hello again. The pillow can't have you."},
    {"id": "back.again.03", "pool": "back.again", "emotion": "pouty", "gesture": null, "tag": null, "text": "I'm back. Let's really get up this time."},
    {"id": "back.last.01", "pool": "back.last", "emotion": "sulky", "gesture": null, "tag": null, "text": "No more snoozes left. Let's play."},
    {"id": "back.last.02", "pool": "back.last", "emotion": "sulky", "gesture": "shake", "tag": null, "text": "That was the last one. Time to get up."},
    {"id": "back.last.03", "pool": "back.last", "emotion": "sulky", "gesture": null, "tag": "[sighs]", "text": "Okay, I waited. Now it's game time."},

    {"id": "emergency.01", "pool": "emergency", "emotion": "worried", "gesture": null, "tag": "[concerned]", "text": "Alarm off. I hope everything's okay."},
    {"id": "emergency.02", "pool": "emergency", "emotion": "worried", "gesture": null, "tag": "[gently]", "text": "Okay, stopped. Take care of yourself."},

    {"id": "game.intro.01", "pool": "game.intro", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Game time! Wake up your brain with me."},
    {"id": "game.intro.02", "pool": "game.intro", "emotion": "cheerful", "gesture": "nod", "tag": null, "text": "Let's play. Win, and the alarm stops."},
    {"id": "game.intro.03", "pool": "game.intro", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Ready? A quick game, then you're free."},
    {"id": "game.intro.04", "pool": "game.intro", "emotion": "cheerful", "gesture": null, "tag": "[playfully]", "text": "Okay. Show me those sleepy eyes can focus."},
    {"id": "game.intro.05", "pool": "game.intro", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Here we go. Just a small game."},
    {"id": "game.intro.06", "pool": "game.intro", "emotion": "cheerful", "gesture": null, "tag": "[playfully]", "text": "Beat me at this, and I'll be quiet."},
    {"id": "game.intro.07", "pool": "game.intro", "emotion": "cheerful", "gesture": "joy", "tag": "[cheerfully]", "text": "Let's play a little. Eyes open!"},
    {"id": "game.intro.08", "pool": "game.intro", "emotion": "cheerful", "gesture": null, "tag": null, "text": "One game, and the morning is yours."},
    {"id": "game.intro.pads.01", "pool": "game.intro.pads", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Watch my hand, then copy the colours."},
    {"id": "game.intro.pads.02", "pool": "game.intro.pads", "emotion": "cheerful", "gesture": "nod", "tag": null, "text": "Colours today. Follow my hand, okay?"},
    {"id": "game.intro.pads.03", "pool": "game.intro.pads", "emotion": "cheerful", "gesture": null, "tag": "[excited]", "text": "Memory game! Remember my colours."},
    {"id": "game.intro.cups.01", "pool": "game.intro.cups", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Cups today. Keep your eyes on the ball."},
    {"id": "game.intro.cups.02", "pool": "game.intro.cups", "emotion": "cheerful", "gesture": null, "tag": "[playfully]", "text": "Where's the ball? Follow it, don't blink."},
    {"id": "game.intro.cups.03", "pool": "game.intro.cups", "emotion": "cheerful", "gesture": null, "tag": "[playfully]", "text": "Three cups, one ball. Easy, right?"},
    {"id": "game.intro.speech.01", "pool": "game.intro.speech", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Say it with me. Three short sentences."},
    {"id": "game.intro.speech.02", "pool": "game.intro.speech", "emotion": "cheerful", "gesture": "nod", "tag": "[cheerfully]", "text": "Let's talk! Repeat after me."},
    {"id": "game.intro.speech.03", "pool": "game.intro.speech", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Wake up your voice. Say what I say."},
    {"id": "game.last.01", "pool": "game.last", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Last one! You can do it."},
    {"id": "game.last.02", "pool": "game.last", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Final round. Stay with me."},
    {"id": "game.last.03", "pool": "game.last", "emotion": "cheerful", "gesture": null, "tag": null, "text": "One more, and you're free."},
    {"id": "game.last.04", "pool": "game.last", "emotion": "cheerful", "gesture": null, "tag": "[excited]", "text": "Last round. Eyes open!"},

    {"id": "pads.watch.01", "pool": "pads.watch", "emotion": "cheerful", "gesture": null, "tag": "[softly]", "text": "Watch my hand~"},
    {"id": "pads.watch.02", "pool": "pads.watch", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Eyes on me."},
    {"id": "pads.watch.03", "pool": "pads.watch", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Here it comes."},
    {"id": "pads.good.01", "pool": "pads.good", "emotion": "cheerful", "gesture": "nod", "tag": null, "text": "Yes! That's right."},
    {"id": "pads.good.02", "pool": "pads.good", "emotion": "cheerful", "gesture": null, "tag": "[excited]", "text": "Nice memory!"},
    {"id": "pads.good.03", "pool": "pads.good", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Perfect!"},
    {"id": "pads.good.04", "pool": "pads.good", "emotion": "cheerful", "gesture": null, "tag": null, "text": "You got it!"},
    {"id": "pads.good.05", "pool": "pads.good", "emotion": "cheerful", "gesture": "nod", "tag": null, "text": "Good! Keep going."},
    {"id": "pads.slow.01", "pool": "pads.slow", "emotion": "pouty", "gesture": null, "tag": "[playfully]", "src": "strings.xml pads_scold_slow[0]", "text": "Too slow~ Is the blanket helping you?"},
    {"id": "pads.slow.02", "pool": "pads.slow", "emotion": "pouty", "gesture": null, "tag": null, "src": "strings.xml pads_scold_slow[1]", "text": "Hello? My hand got tired waiting."},
    {"id": "pads.slow.03", "pool": "pads.slow", "emotion": "pouty", "gesture": null, "tag": "[playfully]", "src": "strings.xml pads_scold_slow[2]", "text": "Still dreaming? Let's try a new one."},
    {"id": "pads.slow.04", "pool": "pads.slow", "emotion": "pouty", "gesture": null, "tag": null, "text": "Hello? Your turn, sleepyhead."},
    {"id": "pads.slow.05", "pool": "pads.slow", "emotion": "pouty", "gesture": null, "tag": "[sighs]", "text": "I waited so long. Let's try again."},
    {"id": "pads.slow.06", "pool": "pads.slow", "emotion": "pouty", "gesture": null, "tag": "[playfully]", "text": "Are you still with me? New one~"},
    {"id": "pads.wrong.01", "pool": "pads.wrong", "emotion": "pouty", "gesture": null, "tag": null, "src": "strings.xml pads_scold_wrong[0]", "text": "Hmm, not that one. Watch my hand again."},
    {"id": "pads.wrong.02", "pool": "pads.wrong", "emotion": "pouty", "gesture": null, "tag": "[playfully]", "src": "strings.xml pads_scold_wrong[1]", "text": "Close! The blanket made you miss it."},
    {"id": "pads.wrong.03", "pool": "pads.wrong", "emotion": "pouty", "gesture": null, "tag": null, "src": "strings.xml pads_scold_wrong[2]", "text": "Oops. Okay, a fresh one. Eyes open~"},
    {"id": "pads.wrong.04", "pool": "pads.wrong", "emotion": "pouty", "gesture": null, "tag": null, "text": "Not quite. My hand was right here."},
    {"id": "pads.wrong.05", "pool": "pads.wrong", "emotion": "pouty", "gesture": null, "tag": null, "text": "Oops, wrong colour. Let's try a new one."},
    {"id": "pads.wrong.06", "pool": "pads.wrong", "emotion": "pouty", "gesture": null, "tag": "[gently]", "text": "Almost! Let's go again."},

    {"id": "cups.watch.01", "pool": "cups.watch", "emotion": "cheerful", "gesture": null, "tag": "[softly]", "text": "Watch the ball…"},
    {"id": "cups.watch.02", "pool": "cups.watch", "emotion": "cheerful", "gesture": null, "tag": "[playfully]", "text": "Don't blink~"},
    {"id": "cups.watch.03", "pool": "cups.watch", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Here I go. Follow it!"},
    {"id": "cups.right.01", "pool": "cups.right", "emotion": "cheerful", "gesture": null, "tag": "[excited]", "text": "You found it!"},
    {"id": "cups.right.02", "pool": "cups.right", "emotion": "cheerful", "gesture": "nod", "tag": null, "text": "Yes, that's the one!"},
    {"id": "cups.right.03", "pool": "cups.right", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Sharp eyes!"},
    {"id": "cups.right.04", "pool": "cups.right", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Right again!"},
    {"id": "cups.right.05", "pool": "cups.right", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Good! You're awake now."},
