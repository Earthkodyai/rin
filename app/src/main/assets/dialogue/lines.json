    {"id": "ring.late.03", "pool": "ring.late", "emotion": "worried", "gesture": null, "tag": null, "text": "I'm a bit late today. Sorry! Up we go."},

    {"id": "snooze.first.01", "pool": "snooze.first", "emotion": "cheerful", "gesture": "nod", "tag": "[playfully]", "text": "A few more minutes… just this once!"},
