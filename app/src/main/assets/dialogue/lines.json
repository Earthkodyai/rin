    {"id": "ring.dayoff.04", "pool": "ring.dayoff", "emotion": "cheerful", "gesture": "joy", "tag": null, "text": "Morning! A free day ahead. What a nice start."},
    {"id": "ring.dayoff.05", "pool": "ring.dayoff", "emotion": "relieved", "gesture": "nod", "tag": "[warmly]", "text": "Good morning. Today can be easy."},
    {"id": "ring.dayoff.06", "pool": "ring.dayoff", "emotion": "cheerful", "gesture": "wave", "tag": "[playfully]", "text": "Hey, weekend you. Up we get~"},
    {"id": "ring.dayoff.07", "pool": "ring.dayoff", "emotion": "cheerful", "gesture": null, "tag": null, "text": "Morning! The whole day is yours."},

    {"id": "ring.late.01", "pool": "ring.late", "emotion": "worried", "gesture": null, "tag": "[concerned]", "text": "Sorry, I'm late! Your phone was asleep."},
