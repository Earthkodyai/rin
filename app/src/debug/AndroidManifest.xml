<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: adb hooks for smoke tests (alarms, and crashing the character renderer). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugAlarmReceiver"
            android:directBootAware="true"
            android:exported="true"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools" />
        <!-- Walk-versus-shake measurement (task 3.1), portrait so a shake cannot restart it. -->
        <activity
            android:name=".debug.StepLabActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            xmlns:tools="http://schemas.android.com/tools" />
        <receiver
            android:name=".debug.DebugCharacterReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools" />
    </application>
</manifest>
