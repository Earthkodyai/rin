rules_version = '2';

// The tournament leaderboard (G.6, ADR 0008): one row per player per game, written only by its owner, only when it is
// no worse than before, with every field checked. The app keeps the same limits in tournament/online/OnlineLimits.kt
// (OnlineLimitsTest compares them with this file). Tests: firebase/test/rules.test.mjs on the emulator.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The developer bans a player by creating banned/{uid} in the Firebase console; nothing in the app reads it.
    function notBanned() {
      return !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }

    function game(g) {
      return g in ['pads', 'cups'];
    }

    // Optional and short; no control, zero-width or direction-override characters (they can disguise a name), and no
    // spaces at either end (the app trims).
    function validName(n) {
      return n is string && n.size() <= 20
        && !n.matches('(?s).*[\\x{0}-\\x{1F}\\x{7F}\\x{200B}-\\x{200F}\\x{202A}-\\x{202E}\\x{2060}-\\x{2069}\\x{FEFF}].*')
        && (n == '' || n.matches('(?s)\\S(.*\\S)?'));
    }

    // One of the 50 universities in the app's list (tournament/Universities.kt, G.7), or null for "Not listed".
    function validUniversity(u) {
      return u == null || u in [
        'cu', 'mu', 'cmu', 'ku', 'kku', 'psu', 'tu', 'kmutnb', 'kmutt', 'ait',
        'kmitl', 'sut', 'wu', 'nu', 'swu', 'su', 'rmuti', 'msu', 'buu', 'ssru',
        'bu', 'mju', 'au', 'mfu', 'rsu', 'ru', 'rmutt', 'pkru', 'sru', 'ubu',
        'bru', 'up', 'stou', 'stiu', 'nida', 'nrru', 'cmru', 'snru', 'mcu', 'tsu',
        'yru', 'rmutk', 'lpru', 'hcu', 'kru', 'sdu', 'dpu', 'cpru', 'rmutto', 'utcc'
      ];
    }

    // Levels 1..500. The time from GO to the last level passed: at least 1 s a level (Rin's demo alone takes longer,
    // see TournamentLadder), at most a day.
    function validScore(d) {
      return d.levels is int && d.levels >= 1 && d.levels <= 500
        && d.timeMs is int && d.timeMs >= d.levels * 1000 && d.timeMs <= 86400000;
    }

    function validRow(d) {
      return d.keys().hasOnly(['name', 'uni', 'levels', 'timeMs', 'at'])
        && d.keys().hasAll(['name', 'uni', 'levels', 'timeMs', 'at'])
        && validName(d.name) && validUniversity(d.uni) && validScore(d)
        && d.at == request.time;
    }

    // More levels, or as many in no more time. Equal lets a player change their name or university.
    function noWorse(n, o) {
      return n.levels > o.levels || (n.levels == o.levels && n.timeMs <= o.timeMs);
    }

    match /boards/{g}/scores/{uid} {
      allow read: if signedIn() && game(g);
      allow create: if signedIn() && request.auth.uid == uid && game(g) && notBanned()
        && validRow(request.resource.data);
      // At most one change every 5 s.
      allow update: if signedIn() && request.auth.uid == uid && notBanned()
        && validRow(request.resource.data) && noWorse(request.resource.data, resource.data)
        && request.time > resource.data.at + duration.value(5, 's');
      // A player can always take their rows down (PDPA: withdrawing consent), banned or not.
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // "Report" on a row: one report per reporter, game and row (the id says which), never read back by players.
    match /reports/{id} {
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['game', 'target', 'at'])
        && request.resource.data.keys().hasAll(['game', 'target', 'at'])
        && game(request.resource.data.game)
        && request.resource.data.target is string
        && request.resource.data.target != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.game + '_' + request.resource.data.target
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/boards/$(request.resource.data.game)/scores/$(request.resource.data.target));
    }
  }
}
